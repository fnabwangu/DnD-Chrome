{
  "name": "living-rpg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Web-first AI-moderated turn-based RPG monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --import tsx tests/unit/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm --parallel --filter @living-rpg/api --filter @living-rpg/web dev",
    "validate:campaign": "tsx scripts/validate-campaign.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
